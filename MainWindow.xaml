<Window x:Class="WinPurifyPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinPurifyPro.ViewModels"
        xmlns:conv="clr-namespace:WinPurifyPro.Converters"
        xmlns:models="clr-namespace:WinPurifyPro.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Icon="WinPurify.ico"
        Height="840" Width="1300"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrush" />
        <conv:RiskToBackgroundConverter x:Key="RiskToBg" />
        <conv:StatusToVisibilityConverter x:Key="StatusToVis" />
        <conv:InverseBooleanConverter x:Key="InvBool" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />
        <conv:CategoryToActiveBackgroundConverter x:Key="CatActiveBg" />
        <conv:CategoryToActiveForegroundConverter x:Key="CatActiveFg" />
        <conv:CategoryToActiveBorderBrushConverter x:Key="CatActiveBorder" />
        <conv:CategoryToSpecialVisibilityConverter x:Key="CatToSpecialVis" />
        <conv:SpecialSubCategoryToActiveBackgroundConverter x:Key="SpecialSubCatBg" />
        <conv:SpecialSubCategoryToActiveForegroundConverter x:Key="SpecialSubCatFg" />
        <conv:SpecialSubCategoryToActiveBorderBrushConverter x:Key="SpecialSubCatBorder" />
        <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />

        <Style x:Key="CategoryNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White Background & Black Text Scan Button Style -->
        <Style x:Key="ScanWhiteButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Quick Action Button Style with Safe Disabled Visuals -->
        <Style x:Key="SidebarQuickButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="presetBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="presetBorder" Property="Background" Value="{DynamicResource BgDark}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Theme Toggle Button Style -->
        <Style x:Key="ThemeToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="themeBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="themeBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Title Header & Official Links -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E293B" Offset="0.0" />
                                    <GradientStop Color="#0F172A" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0.0" />
                                    <GradientStop Color="#0284C7" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#38BDF8" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                            </Border.Effect>
                            <Image Source="WinPurify_icon.png" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="#0284C7" BlurRadius="6" ShadowDepth="1" Opacity="0.4" />
                                </Image.Effect>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="WinPurify Pro" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="{Binding AppHeaderSubtitle}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                    
                    <!-- Official Dev & Company Links -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,0,0,3">
                                <Run Text="개발자: " FontWeight="SemiBold" Foreground="#E2E8F0" />
                                <Run Text="AhBiYout" Foreground="#38BDF8" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock FontSize="10" Margin="0,0,0,2">
                                <Hyperlink NavigateUri="https://ahbiyoutvibe.blogspot.com/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#A78BFA" TextDecorations="None">
                                    <Run Text="🌐 구글 블로그" />
                                </Hyperlink>
                                <Run Text="  |  " Foreground="#475569" />
                                <Hyperlink NavigateUri="http://www.cisnet.co.kr/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8" TextDecorations="None">
                                    <Run Text="🏢 CISNET" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Content="📜 라이선스 정의 (KO / EN)" Command="{Binding OpenLicenseModalCommand}"
                            Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                            FontSize="10.5" FontWeight="SemiBold" Padding="8,5" Margin="0,5,0,0" Cursor="Hand"
                            ToolTip="한국어 및 영어 2종 소프트웨어 최종 사용자 사용권 계약서(EULA) 전문을 확인합니다.">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Category Filters -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,0,0,6" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="⚡ 전체 모듈 (133개)" Command="{Binding FilterCategoryCommand}"
                                ToolTip="시스템 133개 최적화, 제로트레이스 및 심층 정화 모듈 전체를 한눈에 확인하고 제어합니다."
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter=All}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter=All}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter=All}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🛡️ 개인정보 보호 (27)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Privacy}"
                                ToolTip="Windows 자격증명, RDP/USB 포렌식 이력, 텔레메트리, BAM/DAM 등 27개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Privacy}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Privacy}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Privacy}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🌐 브라우저 최적화 (21)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Browser}"
                                ToolTip="웹 브라우저 및 메신저(카카오톡/Discord/Teams/Slack) 세션 토큰 등 21개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Browser}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Browser}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Browser}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🔒 보안 센터 (10)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Security}"
                                ToolTip="Windows Defender 검사 히스토리, 방화벽 로그, 격리소 파편 소거 등 10개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Security}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Security}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Security}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="⚙️ 레지스트리 (15)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Registry}"
                                ToolTip="MUI 인터페이스 캐시, 무효 CLSID 클래스, 고립된 앱 연계 레지스트리 정리 15개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Registry}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Registry}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Registry}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🔄 업데이트 관리 (15)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Update}"
                                ToolTip="설치 완료된 Windows Update 다운로드 잔여물 및 전송 최적화 캐시 정리 15개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Update}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Update}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Update}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🚀 시스템 가속 (15)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.System}"
                                ToolTip="DNS 리졸버 캐시 플러시, DirectX 셰이더 캐시 정리, 시스템 반응속도 향상 15개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.System}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.System}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.System}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="💾 저장공간 정리 (29)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Storage}"
                                ToolTip="Windows/사용자 Temp 폴더, 전 드라이브 휴지통, 메모리 덤프(MEMORY.DMP), hiberfil, WinSxS 등 29개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Storage}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Storage}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Storage}}" />
                        <Button Style="{StaticResource CategoryNavButton}" Content="🛑 특수 기능 (12)" Command="{Binding FilterCategoryCommand}" CommandParameter="{x:Static models:TaskCategory.Special}"
                                ToolTip="통합 계정 정화 센터(Microsoft/Adobe/AutoCAD/Edge/Chrome/자격증명 일괄 로그아웃), 브라우저 공장 초기화(Chrome/Edge/Whale/Firefox), Windows 기본 프로필(Default) 덮어쓰기 복제, 디스크 포렌식 와이핑(Cipher) 등 자동 선택 제외 특수/고급 기능 12개 모듈"
                                Background="{Binding SelectedCategory, Converter={StaticResource CatActiveBg}, ConverterParameter={x:Static models:TaskCategory.Special}}"
                                Foreground="{Binding SelectedCategory, Converter={StaticResource CatActiveFg}, ConverterParameter={x:Static models:TaskCategory.Special}}"
                                BorderBrush="{Binding SelectedCategory, Converter={StaticResource CatActiveBorder}, ConverterParameter={x:Static models:TaskCategory.Special}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Native Quick Actions & Rollback (Bottom of Sidebar) -->
                <Border Grid.Row="2" Background="#111827" CornerRadius="10" Padding="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="HARDWARE ACCELERATOR &amp; TOOLS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🧠 RAM 즉시 압축 (Trim)" Command="{Binding CompressRamCommand}" Background="#0284C7"
                                ToolTip="물리 메모리의 불필요한 프로세스 Working Set을 네이티브 Win32 API로 즉시 비워 여유 RAM을 확보합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🔐 계정 로그아웃 &amp; 자격 증명 정화" Command="{Binding OpenCredentialPurgeModalCommand}" Background="#E11D48"
                                ToolTip="Microsoft, Adobe, AutoCAD, Edge, Chrome, Windows 자격증명 등 로그인된 사용자 세션을 원클릭으로 강제 로그아웃/소거합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🎮 게이밍 부스트 모드" Command="{Binding GameBoostCommand}" Background="#16A34A"
                                ToolTip="게임 프로세스 우선순위를 격상하고 네트워크 지연 요소를 일시 차단하여 인게임 렉을 방지합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="⏰ 주간 자동 스케줄러" Command="{Binding ToggleScheduleCommand}" Background="#EA580C"
                                ToolTip="원하는 요일과 시간에 맞춰 무인 백그라운드 자동 정화 작업을 스케줄링합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🔔 시스템 트레이 &amp; 알림" Command="{Binding OpenTraySettingsModalCommand}" Background="#4338CA"
                                ToolTip="백그라운드 시스템 트레이 상주, 작업 진행사항 실시간 툴팁 및 풍선/토스트 알림 설정을 구성합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🚀 GitHub 실시간 업데이트" Command="{Binding OpenUpdateModalCommand}" Background="#0284C7"
                                ToolTip="GitHub Releases(AhBiYout/AhBiYout-all)를 실시간 조회하여 최신 버전 유무를 확인하고 원클릭 자동 업데이트를 수행합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="🩺 무결성 셀프 진단" Command="{Binding RunDiagnosticsCommand}" Background="#0D9488"
                                ToolTip="관리자 권한, C++ Native 코어 로드 상태, Robocopy I/O 엔진 등 시스템 정합성을 진단합니다." />
                        <Button Style="{StaticResource SidebarQuickButton}" Content="↩️ 세이프포인트 롤백" Command="{Binding RollbackSafepointCommand}" IsEnabled="{Binding HasSafepoint}" Background="#7C3AED" Margin="0"
                                ToolTip="정화 직전에 자동으로 백업된 레지스트리 스냅샷을 1-Click으로 이전 상태로 안전하게 복구합니다." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="130" />
            </Grid.RowDefinitions>

            <!-- Realtime Hardware Metrics Monitor Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Metric Card -->
                <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="CPU 점유율" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding CpuUsage, StringFormat=' {0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="4" Background="{DynamicResource BgDark}" Foreground="{DynamicResource AccentCyan}" BorderThickness="0" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- RAM Metric Card -->
                <Border Grid.Column="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="10" Margin="3,0,3,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM 사용량" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding RamUsageText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ProgressBar Value="{Binding RamUsagePercent}" Maximum="100" Height="4" Background="{DynamicResource BgDark}" Foreground="{DynamicResource AccentGreen}" BorderThickness="0" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Disk Metric Card -->
                <Border Grid.Column="2" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="시스템 드라이브" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding DiskFreeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ProgressBar Value="{Binding DiskUsagePercent}" Maximum="100" Height="4" Background="{DynamicResource BgDark}" Foreground="{DynamicResource AccentAmber}" BorderThickness="0" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Dashboard Stats & Action Header -->
            <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="시스템 정밀 분석 및 초고속 정화 대시보드" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="선택된 모듈: " Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" />
                            <TextBlock Text=" / " Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding TotalTasksCount}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="  |  예상 확보 공간: " Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding FormattedTotalSize}" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" FontSize="14" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Selector Dropdown (다크 / 회색 / 화이트 / 베이지) -->
                        <Border Background="{DynamicResource BgDark}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="11" VerticalAlignment="Center" Margin="6,0,2,0" />
                                <ComboBox SelectedValue="{Binding CurrentTheme, Mode=TwoWay}" SelectedValuePath="Tag" Width="125" Height="28" VerticalAlignment="Center"
                                          Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                          ToolTip="UI 전용 스타일 테마 선택 (다크 / 회색 / 화이트 / 베이지)">
                                    <ComboBoxItem Content="🌙 다크 테마" Tag="Dark" />
                                    <ComboBoxItem Content="🔘 회색 테마" Tag="Gray" />
                                    <ComboBoxItem Content="☀️ 화이트 테마" Tag="White" />
                                    <ComboBoxItem Content="📜 베이지 테마" Tag="Beige" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource ScanWhiteButton}" Content="🔍 초고속 스캔 (Robocopy)" Command="{Binding ScanAllCommand}" Margin="0,0,8,0"
                                ToolTip="Windows Robocopy 가상 메타데이터 I/O 스트림(/L /BYTES)을 사용하여 시스템 부하 없이 전체 모듈의 점유 용량을 초고속 스캔합니다." />
                        <Button Style="{StaticResource ScanWhiteButton}" Content="🔐 계정 로그아웃" Command="{Binding OpenCredentialPurgeModalCommand}" Margin="0,0,8,0" Background="#3B0764" Foreground="#E9D5FF" BorderBrush="#9333EA"
                                ToolTip="Microsoft, Adobe, AutoCAD, Edge, Chrome 및 Windows 자격 증명 관리자의 세션을 원클릭으로 일괄 로그아웃/소거합니다." />
                        <Button Style="{StaticResource ActionPrimaryButton}" Content="⚡ 선택 항목 즉시 정화" Command="{Binding OptimizeSelectedCommand}"
                                ToolTip="레지스트리 세이프포인트를 자동 캡처한 뒤, 3단계 Failover 멀티 엔진(C++ Native -> Fast CLI -> PS Sandbox)을 통해 선택된 모듈을 일괄 정화합니다." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter, Search & Preset Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,6" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="모듈 이름, 설명 키워드를 입력하여 즉시 실시간 필터링합니다." />

                <!-- Presets & Select All Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="프로필: " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <Button Style="{StaticResource PresetButton}" Content="⚡ 완전 초기화 (Zero-Trace)" Command="{Binding SelectZeroTracePresetCommand}" Foreground="#F43F5E"
                            ToolTip="PC 양도/퇴사/중고 판매 전 수준으로 모든 사용자 흔적, 로그인 세션, 비밀번호, 자격증명, 대용량 정크를 100% 일괄 선별합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="🎮 게이밍" Command="{Binding SelectGamingPresetCommand}" Foreground="{DynamicResource AccentCyan}"
                            ToolTip="게이밍 프레임 드랍 방지 및 지연시간 단축을 위해 불필요한 시스템 서비스, 셰이더 캐시, 업데이트 캐시를 선별합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="🛡️ 개인정보" Command="{Binding SelectPrivacyPresetCommand}" Foreground="#A855F7"
                            ToolTip="윈도우 텔레메트리, 진단 로그, 브라우저 방문 기록 등 개인정보 유출 위험 항목을 전수 선별합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="권장 기본 (Safe)" Command="{Binding SelectSafePresetCommand}" Foreground="{DynamicResource AccentGreen}"
                            ToolTip="시스템 동작에 전혀 영향을 주지 않는 100% 안전한 기본 정화 항목만 선별합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="딥 클린 (Deep)" Command="{Binding SelectDeepPresetCommand}" Foreground="{DynamicResource AccentAmber}" Margin="0,0,8,0"
                            ToolTip="안전 항목뿐만 아니라 고립 CLSID, 격리소 파편 등 심층 정화 항목까지 모두 선별합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="전체 선택" Command="{Binding SelectAllCommand}" Foreground="{DynamicResource TextSecondary}"
                            ToolTip="현재 표시된 모든 모듈을 일괄 선택합니다." />
                    <Button Style="{StaticResource PresetButton}" Content="선택 해제" Command="{Binding DeselectAllCommand}" Foreground="{DynamicResource TextSecondary}" Margin="0"
                            ToolTip="선택된 모든 모듈을 일괄 해제합니다." />
                </StackPanel>
            </Grid>

            <!-- Central Tasks List -->
            <Border Grid.Row="3" Background="{DynamicResource BgCard}" CornerRadius="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6">
                        <!-- Special Category Dedicated Launcher Banner -->
                        <Border Visibility="{Binding SelectedCategory, Converter={StaticResource CatToSpecialVis}}"
                                Background="#1A0B2E" BorderBrush="#C026D3" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="2,2,2,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#3B0764" Width="44" Height="44" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🔐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="특수 기능 전용 센터: 통합 계정 정화 &amp; 브라우저 공장 초기화 &amp; 기본 프로필 복제" FontWeight="Bold" Foreground="#F0ABFC" FontSize="13" />
                                        <Border Background="#701A75" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="Zero-Trace &amp; Template" FontSize="9" FontWeight="Bold" Foreground="#F5D0FE" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Microsoft Live/Office WAM 토큰 강제 로그아웃, 브라우저 완전 공장 초기화(User Data 소거), Windows 기본 프로필(C:\Users\Default) 덮어쓰기 복제 등 시스템 원본에 중대한 영향을 미치는 특수 모듈을 안전하게 제어합니다."
                                               Foreground="#E9D5FF" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                                    <TextBlock Text="※ 특수 기능 모듈은 시스템 템플릿 변경 및 데이터 영구 소거 방지를 위해 일반 최적화의 자동 선택에서 기본 제외됩니다."
                                               Foreground="#FDA4AF" FontSize="10" Margin="0,4,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="🔐 계정 정화 센터 열기" Command="{Binding OpenCredentialPurgeModalCommand}"
                                        Background="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Padding="12,8" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Cursor="Hand" ToolTip="계정 자격 증명 및 세션 검사/선택 소거 전용 대화상자를 엽니다.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Special Sub-Category Tabs (Option A) -->
                        <Border Visibility="{Binding SelectedCategory, Converter={StaticResource CatToSpecialVis}}"
                                Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6" Margin="2,0,2,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Tab 1: 전체 (12) -->
                                <Button Grid.Column="0" Command="{Binding FilterSpecialSubCategoryCommand}" CommandParameter="All"
                                        Background="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBg}, ConverterParameter=All}"
                                        Foreground="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatFg}, ConverterParameter=All}"
                                        BorderBrush="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBorder}, ConverterParameter=All}"
                                        BorderThickness="1" Height="36" Margin="0,0,4,0" Cursor="Hand" ToolTip="특수 기능 전체 12개 모듈을 표시합니다.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📑" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="전체 보기" FontWeight="Bold" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                                    <Border Background="#3B0764" CornerRadius="9" Padding="5,1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding SpecialSubCategoryCountAll}" FontSize="9.5" FontWeight="Bold" Foreground="#F0ABFC" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Tab 2: 🔐 계정 & 세션 (6) -->
                                <Button Grid.Column="1" Command="{Binding FilterSpecialSubCategoryCommand}" CommandParameter="Account"
                                        Background="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBg}, ConverterParameter=Account}"
                                        Foreground="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatFg}, ConverterParameter=Account}"
                                        BorderBrush="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBorder}, ConverterParameter=Account}"
                                        BorderThickness="1" Height="36" Margin="0,0,4,0" Cursor="Hand" ToolTip="Microsoft Live/Office, Adobe, Autodesk, Edge, Chrome 및 Windows 자격 증명 정화 모듈 6개">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🔐" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="계정 &amp; 세션" FontWeight="Bold" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                                    <Border Background="#881337" CornerRadius="9" Padding="5,1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding SpecialSubCategoryCountAccount}" FontSize="9.5" FontWeight="Bold" Foreground="#FDA4AF" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Tab 3: 🌐 브라우저 공장 초기화 (4) -->
                                <Button Grid.Column="2" Command="{Binding FilterSpecialSubCategoryCommand}" CommandParameter="FactoryReset"
                                        Background="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBg}, ConverterParameter=FactoryReset}"
                                        Foreground="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatFg}, ConverterParameter=FactoryReset}"
                                        BorderBrush="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBorder}, ConverterParameter=FactoryReset}"
                                        BorderThickness="1" Height="36" Margin="0,0,4,0" Cursor="Hand" ToolTip="Google Chrome, Microsoft Edge, Naver Whale, Mozilla Firefox 브라우저 프로필 전체 소거 모듈 4개">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🌐" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="공장 초기화" FontWeight="Bold" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                                    <Border Background="#7F1D1D" CornerRadius="9" Padding="5,1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding SpecialSubCategoryCountFactoryReset}" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Tab 4: 👥 기본 프로필 복제 (1) -->
                                <Button Grid.Column="3" Command="{Binding FilterSpecialSubCategoryCommand}" CommandParameter="Profile"
                                        Background="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBg}, ConverterParameter=Profile}"
                                        Foreground="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatFg}, ConverterParameter=Profile}"
                                        BorderBrush="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBorder}, ConverterParameter=Profile}"
                                        BorderThickness="1" Height="36" Margin="0,0,4,0" Cursor="Hand" ToolTip="현재 사용자 설정을 Default 사용자 프로필로 복제(Method A) 모듈 1개">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="👥" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="프로필 복제" FontWeight="Bold" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                                    <Border Background="#581C87" CornerRadius="9" Padding="5,1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding SpecialSubCategoryCountProfile}" FontSize="9.5" FontWeight="Bold" Foreground="#D8B4FE" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Tab 5: 🛡️ 포렌식 와이핑 (1) -->
                                <Button Grid.Column="4" Command="{Binding FilterSpecialSubCategoryCommand}" CommandParameter="Forensics"
                                        Background="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBg}, ConverterParameter=Forensics}"
                                        Foreground="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatFg}, ConverterParameter=Forensics}"
                                        BorderBrush="{Binding SelectedSpecialSubCategory, Converter={StaticResource SpecialSubCatBorder}, ConverterParameter=Forensics}"
                                        BorderThickness="1" Height="36" Cursor="Hand" ToolTip="자유 공간 포렌식 난수 덮어쓰기(cipher /w) 모듈 1개">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="포렌식 파쇄" FontWeight="Bold" FontSize="11" Foreground="{TemplateBinding Foreground}" />
                                                    <Border Background="#1E293B" CornerRadius="9" Padding="5,1" Margin="5,0,0,0">
                                                        <TextBlock Text="{Binding SpecialSubCategoryCountForensics}" FontSize="9.5" FontWeight="Bold" Foreground="#E2E8F0" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredTasks}" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardItem}" CornerRadius="7" Padding="12,8" Margin="2,2" BorderBrush="{DynamicResource BorderCardItem}" BorderThickness="1">
                                    <!-- Rich Tooltip for Task Information -->
                                    <Border.ToolTip>
                                        <ToolTip Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" Padding="12,10" HasDropShadow="True">
                                            <StackPanel MaxWidth="380">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding SequenceNumber, StringFormat='#{0:D2}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" FontSize="13" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13" />
                                                    <Border Background="{Binding Risk, Converter={StaticResource RiskToBg}}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Risk}" FontSize="9" FontWeight="Bold" Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,8" />
                                                <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,6" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Category, StringFormat='카테고리: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize, StringFormat='예상 회수 공간: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                                </Grid>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <!-- Streamlined Card Body -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <!-- Task Title & Badges -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Sequence Number Badge -->
                                            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SequenceNumber, StringFormat='#{0:D2}'}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentCyan}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <!-- Risk Badge -->
                                            <Border Background="{Binding Risk, Converter={StaticResource RiskToBg}}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Risk}" FontSize="9" FontWeight="Bold" Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Category Small Tag -->
                                        <Border Grid.Column="2" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" />
                                        </Border>

                                        <!-- Size Indicator -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,12,0" />

                                        <!-- Status Indicator -->
                                        <Border Grid.Column="4" Visibility="{Binding Status, Converter={StaticResource StatusToVis}}" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource AccentCyan}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Bottom Status Bar & Log Console -->
            <Border Grid.Row="4" Background="{DynamicResource BgCard}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Status Bar & Progress & Log Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="💾 디스크 자동 저장" FontSize="9.5" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Log Action Toolbar Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <!-- Auto-Save Toggle CheckBox -->
                            <CheckBox IsChecked="{Binding AutoSaveLogs, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip="작업 로그를 컴퓨터 파일(Logs\WinPurifyPro_YYYYMMDD.log)에 실시간 자동 저장">
                                <TextBlock Text="자동 저장" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </CheckBox>
                            <!-- Open Folder -->
                            <Button Command="{Binding OpenLogFolderCommand}" Content="📂 로그 폴더" Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="로그가 저장된 컴퓨터 폴더 열기" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <!-- Export Button -->
                            <Button Command="{Binding ExportLogsCommand}" Content="📥 내보내기" Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="현재 작업 로그를 바탕화면 텍스트 파일로 저장" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <!-- Clear Button -->
                            <Button Command="{Binding ClearLogConsoleCommand}" Content="🧹" Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="콘솔 화면 지우기 (컴퓨터 디스크 로그는 영구 보존됨)">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <ProgressBar Grid.Column="2" Value="{Binding ProgressValue}" Maximum="{Binding TotalProgressMax}" Height="6" Background="{DynamicResource BgDark}" Foreground="{DynamicResource AccentCyan}" BorderThickness="0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Realtime Log Console -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogConsole}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL: SCHEDULE CUSTOMIZATION DIALOG ================= -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsScheduleModalOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000" Panel.ZIndex="100">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Padding="24" Effect="{DynamicResource WindowDropShadow}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏰ 자동 최적화 태스크 스케줄러 설정" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows 작업 스케줄러(schtasks)와 최고 권한으로 연동되어 부팅 시 또는 지정 주기마다 무음 백그라운드 정화를 수행합니다." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding CloseScheduleModalCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Enable/Disable Switch & Status Telemetry -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="스케줄 자동 실행 활성화" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" />
                                    <TextBlock Text=" • 다음 예정: " FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding NextRunTimeFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </StackPanel>
                                <TextBlock Text="비활성화 시 등록된 Windows 작업 스케줄러 작업이 완전 제거됩니다." FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsScheduled, Mode=TwoWay}" VerticalAlignment="Center" Content="스케줄 사용" Foreground="#38BDF8" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <!-- Trigger Mode Selector (Startup, Interval, Daily, Weekly) -->
                    <TextBlock Text="실행 트리거 선택 (Execution Trigger)" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="🚀 부팅 시 (Startup)" GroupName="ScheduleTrigger" IsChecked="{Binding ScheduleTriggerType, Converter={StaticResource EqToBool}, ConverterParameter=STARTUP, Mode=TwoWay}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="1" Content="⏱️ 반복 간격 (Interval)" GroupName="ScheduleTrigger" IsChecked="{Binding ScheduleTriggerType, Converter={StaticResource EqToBool}, ConverterParameter=INTERVAL, Mode=TwoWay}" Foreground="#A855F7" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="2" Content="🔄 매일 (Daily)" GroupName="ScheduleTrigger" IsChecked="{Binding ScheduleTriggerType, Converter={StaticResource EqToBool}, ConverterParameter=DAILY, Mode=TwoWay}" Foreground="#34D399" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="3" Content="📅 매주 (Weekly)" GroupName="ScheduleTrigger" IsChecked="{Binding ScheduleTriggerType, Converter={StaticResource EqToBool}, ConverterParameter=WEEKLY, Mode=TwoWay}" Foreground="#F59E0B" FontWeight="Bold" />
                    </Grid>

                    <!-- Trigger Details Panel -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <!-- If STARTUP -->
                            <StackPanel Visibility="{Binding IsStartupSchedule, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="시스템 부팅 안정화 대기 지연 시간" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <TextBlock Text="OS 부팅 직후 서비스 구동 부하를 피하기 위해 N분 후 정화를 시작합니다." FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding ScheduleStartupDelayMinutes, Mode=TwoWay}" Width="45" Height="26" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#475569" />
                                        <TextBlock Text="분 지연 후 실행" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- If INTERVAL -->
                            <StackPanel Visibility="{Binding IsIntervalSchedule, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="정기 반복 실행 간격 (Hours)" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <TextBlock Text="PC 구동 중 매 N시간 간격마다 백그라운드 정화를 반복합니다." FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding ScheduleIntervalHours, Mode=TwoWay}" Width="45" Height="26" Background="#0F172A" Foreground="#A855F7" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#475569" />
                                        <TextBlock Text="시간마다 실행" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- If WEEKLY: Day Selector -->
                            <StackPanel Visibility="{Binding IsWeeklySchedule, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="실행 요일 선택:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="일" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=0, Mode=TwoWay}" Foreground="#F87171" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="1" Content="월" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=1, Mode=TwoWay}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="2" Content="화" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=2, Mode=TwoWay}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="3" Content="수" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=3, Mode=TwoWay}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="4" Content="목" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=4, Mode=TwoWay}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="5" Content="금" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=5, Mode=TwoWay}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <RadioButton Grid.Column="6" Content="토" GroupName="ScheduleDay" IsChecked="{Binding ScheduleDayOfWeek, Converter={StaticResource EqToBool}, ConverterParameter=6, Mode=TwoWay}" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- If DAILY or WEEKLY: Time Picker -->
                            <Grid Visibility="{Binding IsStartupSchedule, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="기준 실행 시각: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Text="{Binding ScheduleHour, Mode=TwoWay}" Height="26" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" BorderBrush="#475569" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="2" Text=" : " Foreground="#94A3B8" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Grid.Column="3" Text="{Binding ScheduleMinute, Mode=TwoWay}" Height="26" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" BorderBrush="#475569" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cleanup Target Scope (Profile Selector or Custom Selected Modules) -->
                    <TextBlock Text="정화 대상 모듈 지정 (Module Scope)" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="전체 (132개)" GroupName="ScheduleProfile" IsChecked="{Binding ScheduleProfile, Converter={StaticResource EqToBool}, ConverterParameter=all, Mode=TwoWay}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="1" Content="안전 (Safe)" GroupName="ScheduleProfile" IsChecked="{Binding ScheduleProfile, Converter={StaticResource EqToBool}, ConverterParameter=safe, Mode=TwoWay}" Foreground="#22C55E" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="2" Content="딥클린" GroupName="ScheduleProfile" IsChecked="{Binding ScheduleProfile, Converter={StaticResource EqToBool}, ConverterParameter=deep, Mode=TwoWay}" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="3" Content="게이밍" GroupName="ScheduleProfile" IsChecked="{Binding ScheduleProfile, Converter={StaticResource EqToBool}, ConverterParameter=gaming, Mode=TwoWay}" Foreground="#60A5FA" FontWeight="Bold" Margin="0,0,2,0" />
                        <RadioButton Grid.Column="4" Content="개인정보" GroupName="ScheduleProfile" IsChecked="{Binding ScheduleProfile, Converter={StaticResource EqToBool}, ConverterParameter=privacy, Mode=TwoWay}" Foreground="#C084FC" FontWeight="Bold" />
                    </Grid>

                    <!-- Additional Safety & Optimization Options -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ScheduleCreateSafepoint, Mode=TwoWay}" Content="정화 시작 전 실시간 세이프포인트(레지스트리 스냅샷) 자동 백업 생성" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4" />
                            <CheckBox IsChecked="{Binding ScheduleAutoTrimRam, Mode=TwoWay}" Content="정화 시작 전 RAM 즉시 압축 (Working Set Trim) 동시 수행" Foreground="#CBD5E1" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="취소" Width="60" Height="36" Background="#334155" Foreground="#E2E8F0" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding CloseScheduleModalCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="⚡ 즉시 테스트 실행" Height="36" Padding="12,0" Background="#4338CA" Foreground="#E0E7FF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding RunScheduleNowCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="4" Content="🗑️ 스케줄 제거" Height="36" Padding="12,0" Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" BorderThickness="1" BorderBrush="#EF4444" Cursor="Hand" Command="{Binding UnregisterScheduleCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="6" Content="💾 스케줄 적용 및 저장" Height="36" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding SaveScheduleSettingsCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- System Tray & Notification Center Settings Modal                  -->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsTraySettingsModalOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000" Panel.ZIndex="110">
            <Border Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="#818CF8" BorderThickness="1.5" CornerRadius="14" Padding="22">
                <Border.Effect>
                    <DropShadowEffect Color="#818CF8" BlurRadius="25" ShadowDepth="0" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔔 시스템 트레이 및 작업 감시 센터" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#4338CA" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="System Tray" FontSize="10" FontWeight="Bold" Foreground="#E0E7FF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="작업 진행사항 실시간 툴팁 표시, 풍선/토스트 알림 및 백그라운드 트레이 상주 정책을 제어합니다." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding CloseTraySettingsModalCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Card 1: 트레이 상주 정책 -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📌 윈도우 창 동작 및 트레이 상주" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,6" Cursor="Hand">
                                <TextBlock Text="창 최소화(_) 클릭 시 작업 표시줄 대신 시스템 트레이로 축소" Foreground="#CBD5E1" FontSize="11.5" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,0,0,4" Cursor="Hand">
                                <TextBlock Text="창 닫기(X) 클릭 시 프로그램을 종료하지 않고 트레이 백그라운드에 상주 (권장)" Foreground="#CBD5E1" FontSize="11.5" />
                            </CheckBox>
                            <TextBlock Text="* 백그라운드 상주 중에도 자동 스케줄러 및 실시간 리소스 감시가 지속 실행됩니다." FontSize="10" Foreground="#64748B" Margin="20,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: 작업 진행사항 실시간 감시 -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📊 작업 진행사항 실시간 툴팁 (Tooltip)" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding TrayLiveProgressTooltip, Mode=TwoWay}" Margin="0,0,0,4" Cursor="Hand">
                                <TextBlock Text="트레이 아이콘 마우스 오버 시 실시간 최적화 진행률(%), 처리 모듈명 및 CPU/RAM 점유율 표시" Foreground="#CBD5E1" FontSize="11.5" />
                            </CheckBox>
                            <Border Background="#0F172A" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                                <TextBlock Text="💡 미리보기: WinPurify Pro - 최적화 진행 중 (42/115 - 36%) | CPU: 14% RAM: 42%" FontFamily="Consolas" FontSize="10" Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Windows 알림 센터 (Notification) -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔔 Windows 시스템 트레이 알림 (Balloon / Toast)" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,8" />
                            <CheckBox IsChecked="{Binding TrayNotificationsEnabled, Mode=TwoWay}" Margin="0,0,0,6" Cursor="Hand">
                                <TextBlock Text="최적화 시작 및 완료 시 윈도우 알림 센터 배너 표시" Foreground="#CBD5E1" FontSize="11.5" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding TrayMilestoneNotifications, Mode=TwoWay}" Margin="0,0,0,6" Cursor="Hand">
                                <TextBlock Text="작업 진행률 마일스톤(25%, 50%, 75%) 도달 시 알림 표시" Foreground="#CBD5E1" FontSize="11.5" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="🧪 테스트 알림 즉시 발송" Command="{Binding SendTestTrayNotificationCommand}" Padding="10,5" Background="#312E81" Foreground="#C7D2FE" BorderBrush="#6366F1" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="⬇️ 지금 즉시 트레이로 최소화" Command="{Binding MinimizeToTrayCommand}" Padding="10,5" Margin="8,0,0,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="* 트레이 아이콘을 더블 클릭하면 창이 다시 표시되며, 우클릭 시 빠른 메뉴가 열립니다." FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="확인 완료" Width="90" Height="36" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding CloseTraySettingsModalCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- GitHub Releases Live Auto-Update Modal Dialog                     -->
        <!-- ================================================================= -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsUpdateModalOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000" Panel.ZIndex="120">
            <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="16" Padding="22">
                <Border.Effect>
                    <DropShadowEffect Color="#0284C7" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀 GitHub Releases 실시간 자동 업데이트" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="AhBiYout-all" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="공식 GitHub 리포지토리(AhBiYout/AhBiYout-all)를 실시간 감지하여 원클릭 패치 및 설치를 수행합니다." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Command="{Binding CloseUpdateModalCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Status Card -->
                    <Border Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="현재 설치된 버전" FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GitHub 최신 배포 버전" FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding LatestReleaseVersion, StringFormat='v{0}', TargetNullValue='조회 대기'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#0F172A" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" Foreground="#E2E8F0" TextWrapping="Wrap" />
                            </Border>

                            <!-- Download Progress Bar -->
                            <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="업데이트 설치 파일 다운로드 중..." FontSize="11" Foreground="#38BDF8" />
                                    <TextBlock Text="{Binding UpdateDownloadProgress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="8" Foreground="#0284C7" Background="#334155" BorderThickness="0">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Release Notes Card -->
                    <TextBlock Text="📜 릴리스 변경 내역 (Release Notes)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                    <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1" Height="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseNotes, TargetNullValue='GitHub Releases에 등록된 최신 패치 내역이 표시됩니다.'}"
                                       Foreground="#CBD5E1" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🌐 GitHub 리포지토리" Command="{Binding OpenGitHubRepoCommand}" Height="36" Padding="12,0" Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="🔍 지금 업데이트 확인" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" Height="36" Padding="14,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                        </Button>

                        <Button Grid.Column="4" Content="⚡ 즉시 다운로드 및 설치" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdateAvailable}" Height="36" Padding="14,0" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ================================================================= -->
        <!-- Central Commander Remote Execution Incoming Action Alert Modal    -->
        <!-- ================================================================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsRemoteActionModalOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="1200" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Semi-transparent Backdrop -->
            <Border Background="#D0020617" />

            <!-- Animated Action HUD Card -->
            <Border Width="560" Background="#0B132B" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0284C7" BlurRadius="40" ShadowDepth="0" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Neon Header Bar -->
                    <Border Grid.Row="0" Background="#0F172A" CornerRadius="14,14,0,0" Padding="20,16" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1E3A8A" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60A5FA" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding RemoteActionTitle}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding RemoteActionSourceIp}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0C4A6E" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="REMOTE ACTION" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Middle Content Area -->
                    <StackPanel Grid.Row="1" Margin="24,20">
                        <!-- Command Name Badge -->
                        <Border Background="#1E293B" CornerRadius="10" Padding="16,14" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="명령 내용" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding RemoteActionCommandName}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Live Status with Progress Animation -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RemoteActionStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" />
                            <TextBlock Grid.Column="1" Text="{Binding RemoteActionAutoCloseSeconds, StringFormat='{}{0}초 후 자동 닫힘'}" FontSize="11" Foreground="#64748B" />
                        </Grid>

                        <ProgressBar Height="8" IsIndeterminate="{Binding IsRemoteActionActive}" Maximum="100" Value="100"
                                     Background="#1E293B" Foreground="#0284C7" Margin="0,0,0,16">
                            <ProgressBar.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>

                        <!-- Execution Details Box -->
                        <Border Background="#020617" CornerRadius="8" Padding="14,12" BorderBrush="#1E293B" BorderThickness="1">
                            <TextBlock Text="{Binding RemoteActionDetails}" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- Bottom Action Bar -->
                    <Border Grid.Row="2" Background="#0B0F19" CornerRadius="0,0,14,14" Padding="20,14" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🛡️ 원격 실행 결과는 로컬 감사 로그(remote_execution_history.json)에 영구 보존됩니다."
                                       FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="닫기 (확인)" Command="{Binding CloseRemoteActionModalCommand}"
                                    Width="110" Height="34" Background="#1E293B" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12"
                                    BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- User Account & Credential Session Purge Modal                     -->
        <!-- ================================================================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsCredentialPurgeModalOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="1300" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Semi-transparent Backdrop -->
            <Border Background="#D9020617" />

            <!-- Modal Window Card -->
            <Border Width="820" MaxHeight="780" Background="#0F172A" BorderBrush="#E11D48" BorderThickness="2" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E11D48" BlurRadius="35" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#1E1B4B" CornerRadius="14,14,0,0" Padding="20,16" BorderBrush="#312E81" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#881337" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                    <TextBlock Text="🔐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="통합 계정 &amp; 세션 토큰 정화 센터 (Zero-Trace)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock Text="메신저, 금융인증서, 클라우드 드라이브, 게임, 개발자, OS/오피스 및 브라우저 세션을 완벽 강제 로그아웃합니다."
                                               FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Command="{Binding CloseCredentialPurgeModalCommand}"
                                    Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" FontWeight="Bold" FontSize="16"
                                    BorderThickness="0" Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Warning Alert Banner -->
                    <Border Grid.Row="1" Background="#4C0519" BorderBrush="#BE123C" BorderThickness="0,0,0,1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="실행 시 선택된 서비스의 로그인 쿠키, 메신저 토큰, 인증서, 세션 파일이 영구 소거되며 즉시 로그아웃됩니다."
                                           FontSize="11" Foreground="#FECDD3" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="⚡ 소거 전 실행 중인 세션 프로세스 자동 종료" 
                                      IsChecked="{Binding TerminateProcessesBeforePurge}"
                                      Foreground="#FDE047" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Central Commander Real-time Confirmation Status Log Banner -->
                    <Border Grid.Row="2" Background="#090E17" Padding="16,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header Bar: Commander Link Info -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#0C4A6E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="📡 COMMANDER CONFIRMATION STREAM" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Border>
                                    <TextBlock Text="{Binding LatestCommanderConfirmationStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⚡ 원격 확인 시뮬레이션" Command="{Binding SimulateCommanderConfirmationCommand}"
                                            Padding="7,2" Margin="0,0,6,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontSize="9.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="로그 비우기" Command="{Binding ClearCommanderZeroTraceLogsCommand}"
                                            Padding="6,2" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="9.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Live Confirmation Log Box -->
                            <Border Grid.Row="1" Background="#020617" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Padding="8,6" MaxHeight="65">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CommanderZeroTraceLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1.5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontFamily="Consolas" FontSize="9.5" Foreground="#64748B" Margin="0,0,8,0" />
                                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                                                        <TextBlock Text="CONFIRMED" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Details}" FontFamily="Consolas" FontSize="10" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CommanderIp, StringFormat='[발신: {0}]'}" FontSize="9.5" Foreground="#94A3B8" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
