                            <Button Grid.Column="1" Content="확인 완료 (닫기)" Command="{Binding CloseLicenseModalCommand}"
                                    Width="120" Height="36" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
