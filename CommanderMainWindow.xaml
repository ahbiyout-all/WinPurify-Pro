<Window x:Class="WinPurifyPro.CommanderMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinPurifyPro"
        xmlns:vm="clr-namespace:WinPurifyPro.ViewModels"
        xmlns:conv="clr-namespace:WinPurifyPro.Converters"
        mc:Ignorable="d"
        Title="WinPurify Pro Central Commander Console v4.45.0 (Fleet Management)"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B0F19"
        FontFamily="Segoe UI, Malgun Gothic, sans-serif"
        Icon="WinPurify.ico">

    <Window.DataContext>
        <vm:CommanderViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:EqualityToBooleanConverter x:Key="EqToBool" />
        <conv:SpecialCategoryToVisibilityConverter x:Key="SpecCatToVis" />
        <conv:SpecialSubCategoryToActiveBackgroundConverter x:Key="SpecActiveBg" />
        <conv:SpecialSubCategoryToActiveForegroundConverter x:Key="SpecActiveFg" />
        <conv:SpecialSubCategoryToActiveBorderBrushConverter x:Key="SpecActiveBorder" />

        <Style x:Key="SpecialTabRadioBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#7E22CE" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommanderTitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommanderCloseBtn" TargetType="Button" BasedOn="{StaticResource CommanderTitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionPurgeBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0EA5E9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionGameBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F59E0B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionCleanBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionRestoreBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B5CF6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionPresetBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6366F1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionDnsBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#0891B2" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#06B6D4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionDiagBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionRebootBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionShutdownBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#881337" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9F1239" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionRollbackBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#6D28D9" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7C3AED" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionResetBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#BE123C" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E11D48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionScheduleBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F59E0B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionAccountBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionSpecialBtn" TargetType="Button" BasedOn="{StaticResource ActionPrimaryBtn}">
            <Setter Property="Background" Value="#7E22CE" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9333EA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommanderComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="Foreground" Value="#60A5FA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommanderComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CommanderComboBoxItemStyle}" />
        </Style>
    </Window.Resources>

    <Border Background="#0B0F19" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="42" />
                <!-- Sub Header & Security Controls -->
                <RowDefinition Height="Auto" />
                <!-- Fleet Nodes Dashboard -->
                <RowDefinition Height="*" />
                <!-- Batch Command Control Center -->
                <RowDefinition Height="Auto" />
                <!-- Console Log Output -->
                <RowDefinition Height="120" />
                <!-- Status Footer -->
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Custom Window Title Bar -->
            <Grid Grid.Row="0" Background="#0F172A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image Source="WinPurify_icon.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="WinPurify Pro" FontWeight="Bold" FontSize="13" Foreground="#60A5FA" VerticalAlignment="Center" />
                    <TextBlock Text="Central Commander" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Standalone Fleet Console" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                    </Border>
                    <Border Background="#4C1D95" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v4.45.0" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CommanderTitleBtn}" Content="🗕" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource CommanderTitleBtn}" Content="🗖" Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CommanderCloseBtn}" Content="✕" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Control & Security Bar -->
            <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒 클러스터 시크릿 키: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ClusterSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" BorderBrush="#475569" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="4,0,16,0" />

                        <TextBlock Text="➕ 수동 IP 추가: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtCustomIp" Text="192.168.1.100" Width="120" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" BorderBrush="#475569" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="4,0,6,0" />
                        <Button Content="추가" Height="28" Padding="8,0" Background="#334155" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="AddCustomIp_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="{Binding CommanderStatus}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{Binding AgentButtonText}" Style="{StaticResource ActionPrimaryBtn}" Background="{Binding AgentButtonBackground}" Command="{Binding ToggleAgentServerCommand}" Margin="0,0,8,0" ToolTip="로컬 에이전트 수신 포트(TCP:9870) 가동/중지 전환" />
                        <Button Content="🔍 UDP 노드 자동 탐색" Style="{StaticResource ActionPrimaryBtn}" Command="{Binding DiscoverNodesCommand}" Margin="0,0,8,0" />
                        <Button Content="🔄 텔레메트리 갱신" Height="36" Padding="12,0" Background="#1E293B" Foreground="#CBD5E1" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshTelemetryCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fleet PC Nodes Dashboard Grid -->
            <Border Grid.Row="2" Background="#0B0F19" Padding="16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RemoteNodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#131D31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                            <MenuItem Header="📁 이 PC 기본 프로필(Default) 복제 배포" Command="{Binding DataContext.SingleNodeProfileSyncCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#C084FC" FontWeight="Bold" />
                                            <MenuItem Header="🌐 이 PC 브라우저 공장 초기화 (User Data 영구 소거)" Command="{Binding DataContext.SingleNodeBrowserResetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#FB7185" FontWeight="Bold" />
                                            <MenuItem Header="🧹 이 PC 포렌식 디스크 빈 공간 난수 파쇄 (cipher /w)" Command="{Binding DataContext.SingleNodeForensicsWipeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#94A3B8" FontWeight="Bold" />
                                            <Separator Background="#1E293B" />
                                            <MenuItem Header="🔐 이 PC 계정 &amp; 세션 토큰 원격 정화 (Zero-Trace)" Command="{Binding DataContext.SingleNodeAccountPurgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#F43F5E" FontWeight="Bold" />
                                            <MenuItem Header="🛡️ 이 PC에 시스템 복원 지점 생성" Command="{Binding DataContext.SingleNodeRestorePointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#F8FAFC" />
                                            <MenuItem Header="⚡ 이 PC RAM 압축 (Trim Working Set)" Command="{Binding DataContext.SingleNodeRamCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#38BDF8" />
                                            <MenuItem Header="🧹 고속 원터치 유지보수 (휴지통/DNS/임시파일)" Command="{Binding DataContext.SingleNodeQuickCleanCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#4ADE80" />
                                            <MenuItem Header="🚀 e스포츠 게이밍 가속 프로필 배포" Command="{Binding DataContext.SingleNodeGameBoostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#F59E0B" />
                                            <Separator Background="#1E293B" />
                                            <MenuItem Header="↩️ 최근 세이프포인트로 롤백 (복원)" Command="{Binding DataContext.SingleNodeRollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#CBD5E1" />
                                            <MenuItem Header="🔄 원격 시스템 재부팅" Command="{Binding DataContext.SingleNodeRebootCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#FCA5A5" />
                                            <Separator Background="#1E293B" />
                                            <MenuItem Header="🗑️ 관제 대시보드 목록에서 제외" Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#94A3B8" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding GroupName}" FontSize="10" Foreground="#94A3B8" />
                                                </Border>
                                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}:9870'}" FontSize="11" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="CPU 부하율" FontSize="11" Foreground="#94A3B8" />
                                            <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="5" Background="#1E293B" Foreground="#38BDF8" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding CpuUsage, StringFormat=' {0:F0}% 점유'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="물리 RAM 사용량" FontSize="11" Foreground="#94A3B8" />
                                            <ProgressBar Value="{Binding RamUsage}" Maximum="100" Height="5" Background="#1E293B" Foreground="#4ADE80" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding RamText}" FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="시스템 최적화 점수" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding OptimizationScore, StringFormat='{}{0}점 (144개 모듈)'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="⚡ RAM" ToolTip="해당 PC 물리 RAM 압축" Height="26" Padding="6,0" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeRamCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="🧹 퀵정화" ToolTip="해당 PC 고속 유지보수" Height="26" Padding="6,0" Background="#059669" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeQuickCleanCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="🔐 계정" ToolTip="해당 PC 통합 계정 &amp; 세션 토큰 정화 (Zero-Trace 강제 로그아웃)" Height="26" Padding="6,0" Background="#991B1B" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeAccountPurgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="✨ 특수" ToolTip="원격 특수 기능 허브 (프로필 복제/브라우저 초기화/포렌식 파쇄)" Height="26" Padding="6,0" Background="#7E22CE" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenSpecialOpsModalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="🚀 부스트" ToolTip="게이밍 우선순위 최적화" Height="26" Padding="6,0" Background="#D97706" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeGameBoostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="↩ 롤백" ToolTip="해당 PC 세이프포인트(백업 레지스트리) 복원" Height="26" Padding="6,0" Background="#6D28D9" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeRollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="🔄" ToolTip="원격 안전 재부팅 (/r /f /t 3)" Height="26" Padding="6,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SingleNodeRebootCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Content="🛑" ToolTip="원격 윈도우 강제 종료 (/s /f /t 3)" Height="26" Padding="6,0" Background="#7F1D1D" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.SingleNodeShutdownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Border Background="#064E3B" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,4,0" />
                                                    <TextBlock Text="ONLINE" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                                </StackPanel>
                                            </Border>
                                            <Button Content="✕" ToolTip="관제 목록에서 제외" Height="22" Width="22" Background="#1E293B" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Batch Action Control Bar -->
            <Border Grid.Row="3" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,1,0,1" Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: Core Fleet Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="선택 대상 PC: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedNodesCount, StringFormat=' {0}대'}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="전체 선택" Height="26" Padding="8,0" Background="#1E293B" Foreground="#CBD5E1" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding SelectAllNodesCommand}" Margin="0,0,4,0" />
                            <Button Content="선택 해제" Height="26" Padding="8,0" Background="#1E293B" Foreground="#CBD5E1" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding DeselectAllNodesCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="⚡ 물리 RAM 일괄 정화" Style="{StaticResource BatchActionPurgeBtn}" Command="{Binding BatchPurgeRamCommand}" Margin="0,0,6,0" />
                            <Button Content="🚀 게이밍 가속 일괄 배포" Style="{StaticResource BatchActionGameBtn}" Command="{Binding BatchGameBoostCommand}" Margin="0,0,6,0" />
                            <Button Content="🧹 고속 유지보수 (정크/DNS)" Style="{StaticResource BatchActionCleanBtn}" Command="{Binding BatchQuickMaintenanceCommand}" Margin="0,0,6,0" />
                            <Button Content="🛡️ 복원 지점 일괄 생성" Style="{StaticResource BatchActionRestoreBtn}" Command="{Binding BatchRestorePointCommand}" Margin="0,0,6,0" />
                            <Button Content="↩ 세이프포인트 일괄 롤백 (완전 복원)" Style="{StaticResource BatchActionRollbackBtn}" Command="{Binding BatchRollbackCommand}" ToolTip="최적화 이전 세이프포인트로 원격 되돌리기" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Profile Deployment & System Governance -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="최적화 프로필: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding PresetList}" SelectedItem="{Binding SelectedPreset}" Width="110" Height="28" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" FontWeight="Bold" FontSize="11" Style="{StaticResource CommanderComboBoxStyle}" ItemContainerStyle="{StaticResource CommanderComboBoxItemStyle}" Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="📋 프리셋 일괄 배포" Style="{StaticResource BatchActionPresetBtn}" Command="{Binding BatchApplyPresetCommand}" Margin="0,0,6,0" />
                            <Button Content="⏰ 주간 자동 스케줄러 일괄 배포" Style="{StaticResource BatchActionScheduleBtn}" Command="{Binding OpenScheduleModalCommand}" ToolTip="선택된 모든 원격 노드에 주간/일간 무인 정화 스케줄 일괄 배포" Margin="0,0,6,0" />
                            <Button Content="🌐 DNS 플러시" Style="{StaticResource BatchActionDnsBtn}" Command="{Binding BatchFlushDnsCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="✨ 원격 특수 기능 센터" Style="{StaticResource BatchActionSpecialBtn}" Command="{Binding OpenSpecialOpsModalCommand}" ToolTip="Option A 4대 카테고리: 기본 프로필 복제, 브라우저 공장초기화, 디스크 포렌식 파쇄, 계정 정화" Margin="0,0,6,0" />
                            <Button Content="🔐 통합 계정 정화" Style="{StaticResource BatchActionAccountBtn}" Command="{Binding OpenAccountPurgeModalCommand}" ToolTip="사무실 PC 반납/양도/보안점검 시 다중 PC의 모든 계정 토큰 및 세션 원격 일괄 강제 로그아웃" Margin="0,0,6,0" />
                            <Button Content="💥 Zero-Trace 초기화" Style="{StaticResource BatchActionResetBtn}" Command="{Binding BatchZeroTraceResetCommand}" ToolTip="모든 임시파일, 캐시, 휴지통, 최근흔적 일괄 완전 소거" Margin="0,0,6,0" />
                            <Button Content="🔍 클러스터 진단" Style="{StaticResource BatchActionDiagBtn}" Command="{Binding BatchDiagnosticsCommand}" Margin="0,0,6,0" />
                            <Button Content="🔄 원격 안전 재부팅" Style="{StaticResource BatchActionRebootBtn}" Command="{Binding BatchRebootCommand}" Margin="0,0,6,0" />
                            <Button Content="🛑 원격 윈도우 종료" Style="{StaticResource BatchActionShutdownBtn}" Command="{Binding BatchShutdownCommand}" ToolTip="선택된 모든 원격 노드에 4-Tier 시스템 강제 종료(/s /f /t 3) 명령 일괄 하달" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Console Log Stream -->
            <Border Grid.Row="4" Background="#020617" Padding="10" BorderBrush="#0F172A" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="실시간 관제 이벤트 및 보안 감사 로그 (HMAC-SHA256 Signed)" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="💾 디스크 자동 저장 중" FontSize="9.5" Foreground="#34D399" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <!-- Log Action Toolbar Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Auto-Save Toggle CheckBox -->
                            <CheckBox IsChecked="{Binding AutoSaveLogs, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip="관제 로그를 컴퓨터 파일(Logs\WinPurifyCommander_YYYYMMDD.log)에 실시간 자동 저장">
                                <TextBlock Text="자동 저장" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </CheckBox>
                            <!-- Open Folder -->
                            <Button Command="{Binding OpenCommanderLogFolderCommand}" Content="📂 관제 로그 폴더" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="관제 로그가 저장된 컴퓨터 폴더 열기" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <!-- Export Button -->
                            <Button Command="{Binding ExportCommanderLogsCommand}" Content="📥 내보내기" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="현재 관제 로그를 바탕화면 텍스트 파일로 저장" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                            <!-- Clear Button -->
                            <Button Command="{Binding ClearCommanderLogsCommand}" Content="🧹" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="10" Padding="6,2" Cursor="Hand" ToolTip="화면 콘솔 지우기 (컴퓨터 디스크 로그는 영구 보존됨)">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommanderLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status Footer -->
            <Grid Grid.Row="5" Background="#0F172A" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="클러스터 노드 현황: " FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="{Binding OnlineNodesCount, StringFormat='온라인 {0}대'}" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="4,0,8,0" />
                    <TextBlock Text="{Binding TotalNodesCount, StringFormat='(총 {0}대 등록)'}" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://ahbiyoutvibe.blogspot.com/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#A78BFA" TextDecorations="None">
                            <Run Text="🌐 구글 블로그" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding CommanderVersion}" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Fleet Weekly Auto-Scheduler Modal Dialog Overlay -->
            <Border Grid.RowSpan="6" Background="#DD020617" Visibility="{Binding IsScheduleModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="560" Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="24" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏰" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="클러스터 원격 주간 자동 스케줄러 일괄 배포" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="선택된 모든 원격 노드에 Windows 작업 스케줄러(schtasks) 무인 정화 작업을 자동 등록합니다." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Command="{Binding CloseScheduleModalCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Target Count Badge -->
                            <Border Background="#1E3A8A" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📡 배포 대상 노드:" FontSize="11" Foreground="#93C5FD" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedNodesCount, StringFormat=' 온라인 PC {0}대'}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Schedule Frequency -->
                            <TextBlock Text="실행 주기 선택" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="📅 매주 특정 요일 (Weekly)" GroupName="FleetFreq" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" IsChecked="{Binding ScheduleFrequency, Converter={StaticResource EqToBool}, ConverterParameter=WEEKLY, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton Grid.Column="1" Content="🔄 매일 반복 실행 (Daily)" GroupName="FleetFreq" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" IsChecked="{Binding ScheduleFrequency, Converter={StaticResource EqToBool}, ConverterParameter=DAILY, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Day of Week & Time -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="실행 요일" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ComboBox SelectedIndex="{Binding ScheduleDay, Mode=TwoWay}" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" FontWeight="Bold" FontSize="11" Style="{StaticResource CommanderComboBoxStyle}" ItemContainerStyle="{StaticResource CommanderComboBoxItemStyle}">
                                        <ComboBoxItem Content="일요일 (SUN)" />
                                        <ComboBoxItem Content="월요일 (MON)" />
                                        <ComboBoxItem Content="화요일 (TUE)" />
                                        <ComboBoxItem Content="수요일 (WED)" />
                                        <ComboBoxItem Content="목요일 (THU)" />
                                        <ComboBoxItem Content="금요일 (FRI)" />
                                        <ComboBoxItem Content="토요일 (SAT)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="실행 시각 (24시간)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding HoursList}" SelectedItem="{Binding ScheduleHour, Mode=TwoWay}" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" FontWeight="Bold" FontSize="11" Style="{StaticResource CommanderComboBoxStyle}" ItemContainerStyle="{StaticResource CommanderComboBoxItemStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='{}{0:D2}시'}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="1" Text=":" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding MinutesList}" SelectedItem="{Binding ScheduleMinute, Mode=TwoWay}" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" FontWeight="Bold" FontSize="11" Style="{StaticResource CommanderComboBoxStyle}" ItemContainerStyle="{StaticResource CommanderComboBoxItemStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='{}{0:D2}분'}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Target Optimization Profile -->
                            <TextBlock Text="정화 대상 최적화 프로필" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PresetList}" SelectedItem="{Binding ScheduleProfile, Mode=TwoWay}" Height="30" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#475569" FontWeight="Bold" FontSize="11" Style="{StaticResource CommanderComboBoxStyle}" ItemContainerStyle="{StaticResource CommanderComboBoxItemStyle}" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Auto Trim RAM -->
                            <CheckBox Content="정화 시작 전 물리 RAM 즉시 압축(Trim Working Set) 동시 수행" IsChecked="{Binding ScheduleAutoTrimRam, Mode=TwoWay}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,20" />

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="스케줄 일괄 해제" Height="34" Padding="12,0" Background="#7F1D1D" Foreground="#FECACA" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding BatchUnregisterScheduleCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="2" Content="취소" Height="34" Padding="14,0" Background="#334155" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding CloseScheduleModalCommand}" Margin="0,0,8,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="3" Content="🚀 선택 노드에 스케줄러 일괄 배포" Height="34" Padding="16,0" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding BatchDeployScheduleCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
