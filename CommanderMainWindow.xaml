                                                             IsChecked="{Binding AccountPurgeScenario, Converter={StaticResource EqToBool}, ConverterParameter=developer, Mode=TwoWay}" />
                                            </WrapPanel>

                                            <CheckBox Content="세션 잠금 방지를 위해 실행 중인 브라우저/앱 선행 강제 종료" IsChecked="{Binding TerminateProcessesBeforePurge, Mode=TwoWay}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,10" />

                                            <Button Content="⚡ 선택 노드 계정 &amp; 세션 일괄 정화 실행" Height="30" Padding="14,0" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                                    Command="{Binding BatchAccountPurgeCommand}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Modal Footer -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E1B4B" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡 배포 대상: " FontSize="11" Foreground="#C7D2FE" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedNodesCount, StringFormat=' 온라인 PC {0}대'}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Content="닫기" Height="32" Padding="16,0" Background="#334155" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" Command="{Binding CloseSpecialOpsModalCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
