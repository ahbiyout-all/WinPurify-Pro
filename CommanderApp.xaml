<Application x:Class="WinPurifyPro.CommanderApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinPurifyPro">
    <Application.Resources>
        <!-- Modern Global Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19" />
        <SolidColorBrush x:Key="BgCard" Color="#111827" />
        <SolidColorBrush x:Key="BgSidebar" Color="#0F172A" />
        <SolidColorBrush x:Key="BorderDark" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
    </Application.Resources>
</Application>
